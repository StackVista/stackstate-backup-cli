{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>StackVista/renovate-config",
    "github>StackVista/renovate-config:go"
  ],
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Review major upgrades separately without rebasing for unrelated changes",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Automerge compatible action updates after required CI and App approval",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Review CI tool updates separately from action references",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchPackageNames": [
        "golangci/golangci-lint",
        "goreleaser/goreleaser",
        "github.com/google/go-licenses",
        "golang.org/x/vuln"
      ],
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "groupName": "CI tools",
      "groupSlug": "ci-tools",
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Track Go modules compatible with the approved compiler release line",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect", "replace"],
      "enabled": true,
      "constraintsFiltering": "strict",
      "constraints": {
        "%goMod": ">=1.0.0 <1.27.0"
      },
      "constraintsVersioning": {
        "%goMod": "semver-coerced"
      }
    },
    {
      "description": "Group and automerge other module minors after required validation and App approval",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect", "replace"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Go library minors",
      "groupSlug": "go-library-minors",
      "group": {
        "branchTopic": "go-library-minors"
      },
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Group coupled AWS SDK minor updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect", "replace"],
      "matchPackageNames": ["github.com/aws/aws-sdk-go-v2{,/**}", "github.com/aws/smithy-go"],
      "matchUpdateTypes": ["minor"],
      "groupName": "AWS Go SDK",
      "groupSlug": "go-aws-sdk",
      "group": {
        "branchTopic": "go-aws-sdk"
      }
    },
    {
      "description": "Group coupled Kubernetes client minor updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect", "replace"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Kubernetes Go clients",
      "groupSlug": "go-kubernetes",
      "group": {
        "branchTopic": "go-kubernetes"
      }
    },
    {
      "description": "Keep module patches separate from minor updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect", "replace"],
      "separateMinorPatch": true
    },
    {
      "description": "Keep Go compiler updates within the approved release line",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "rangeStrategy": "bump",
      "allowedVersions": "/^1\\.26\\./",
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "minimumReleaseAge": null
    },
    {
      "description": "Automerge compiler patches after required artifact validation and App approval",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep module patches separate from compiler updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect", "replace"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Go library updates",
      "groupSlug": "go-libraries",
      "group": {
        "branchTopic": "go-libraries"
      },
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
